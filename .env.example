# ==============================================================================
# Envello - Environment Configuration Template
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# - All variables prefixed with "VITE_" are embedded into the client bundle and are PUBLIC.
# - NEVER put Supabase Service Role Keys, database passwords, or private API secrets here.
# - Copy this file to ".env" for local development: `cp .env.example .env`
# - Never commit ".env" or real credentials to source control.
# ==============================================================================

# Supabase Public Configuration (Required for client)
# Found in: Supabase Project Settings -> API -> Project URL & Project API Keys (anon/public)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Application Configuration
VITE_APP_NAME=Envello
VITE_APP_ENV=development
VITE_APP_URL=http://localhost:5173

# Feature Flags
VITE_ENABLE_AUDIT_LOGGING=true

# ==============================================================================
# Server / Edge Function Environment Variables (DO NOT PREFIX WITH VITE_)
# Configure these in Supabase Dashboard -> Project Settings -> Edge Functions / Secrets
# ==============================================================================
# SUPABASE_SERVICE_ROLE_KEY=your-server-side-service-role-key-never-in-client
# OWNER_EMAIL_ALLOWLIST=owner@example.com
